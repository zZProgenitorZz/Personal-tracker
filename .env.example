# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so it never ends up in git.

# Optional: key for Google Books (covers). Free to create in the
# Google Cloud Console: APIs & Services > Library > "Books API" > Enable,
# then Credentials > Create credentials > API key.
GOOGLE_BOOKS_API_KEY=

# Optional: where backups go. By default your OneDrive\Progen-backups,
# so there is a copy in the cloud too. Path without quotes.
PROGEN_BACKUP_DIR=

# Optional: key for TMDB (covers and genres of films and series in Watching).
# Free at themoviedb.org > Settings > API. An "API Key" or an "API Read Access Token" both work.
TMDB_API_KEY=

# Optional: Spotify for Listening. Create an app at https://developer.spotify.com/dashboard
# with redirect URI http://127.0.0.1:8000/listening/spotify/callback, and fill in its details here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only needed if Progen runs on another port or address (must match the one in the Spotify dashboard exactly).
SPOTIFY_REDIRECT_URI=
# How often Progen syncs with Spotify automatically (in minutes, 30 by default).
SYNC_INTERVAL_MINUTES=

# Optional: key for Sunny, the assistant in the app. Create one at console.anthropic.com > API keys
# and set a monthly limit there right away. Without a key Sunny only shows a short message.
ANTHROPIC_API_KEY=

# Optional: Progen on your phone through Tailscale (see the README). The server keeps listening on
# 127.0.0.1 only; `tailscale serve --bg 8000` gives it an https address on your private tailnet.
# Comma-separated host names, no wildcards, e.g. my-pc.tail1234.ts.net. Through these you must sign in.
PROGEN_EXTRA_HOSTS=
# Set both with: python -m app.auth set-password  (only the hash is stored, never the password).
# With PROGEN_EXTRA_HOSTS set and no password, Progen refuses to start.
PROGEN_PASSWORD_HASH=
PROGEN_SESSION_SECRET=
