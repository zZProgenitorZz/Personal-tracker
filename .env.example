# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en komt dus nooit in git.

# Optioneel: sleutel voor Google Books (covers). Gratis aan te maken in de
# Google Cloud Console: APIs & Services > Library > "Books API" > Enable,
# daarna Credentials > Create credentials > API key.
GOOGLE_BOOKS_API_KEY=

# Optioneel: waar back-ups komen. Standaard je OneDrive\Progen-backups,
# zodat er ook een kopie in de cloud staat. Pad zonder aanhalingstekens.
PROGEN_BACKUP_DIR=

# Optioneel: sleutel voor TMDB (covers en genres van films en series bij Watching).
# Gratis op themoviedb.org > Settings > API. Een "API Key" of "API Read Access Token" werken allebei.
TMDB_API_KEY=
